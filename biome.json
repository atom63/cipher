{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"**",
			"!**/scripts",
			"!**/dist",
			"!**/node_modules",
			"!**/exports/styles",
			"!**/src/styles"
		],
		"ignoreUnknown": true
	},
	"linter": {
		"includes": [
			"**",
			"!**/scripts/**",
			"!**/dist/**",
			"!**/node_modules/**",
			"!**/exports/styles"
		],
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noImportantStyles": "off",
				"useLiteralKeys": "off"
			},
			"a11y": {
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"noAutofocus": "off",
				"noLabelWithoutControl": "off",
				"useAriaPropsSupportedByRole": "off"
			},
			"correctness": {
				"noUnknownTypeSelector": "off"
			}
		}
	},
	"formatter": {
		"includes": [
			"**",
			"!**/scripts/**",
			"!**/dist/**",
			"!**/node_modules/**",
			"!**/*.module.css",
			"!**/exports/styles"
		]
	},
	"css": {
		"formatter": {
			"indentStyle": "tab"
		}
	}
}
