/**
 * Cipher - Figma Plugin
 * Author: You Zhang (ATOM63)
 * TypeScript configuration
 */
{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2021", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["@figma/plugin-typings", "node"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["../../../src/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", "global.d.ts"],
	"exclude": ["node_modules", "dist", "build.js", "libraries/radix-data.ts"]
}
